# Required client authentication. Use one or more long random values separated
# by commas. Never reuse an upstream/provider key.
API_KEYS=

# Global exposure policy.
ALLOWED_MODELS=

# Optional named-connections file. Leave empty for single-provider mode.
LOCALM_CONFIG=

# Single-provider compatibility mode.
LLM_PROVIDER=
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
OLLAMA_BASE_URL=

# Request, rate, and concurrency limits.
MAX_BODY_BYTES=
MAX_TOKENS=
DEFAULT_MAX_TOKENS=
RATE_LIMIT_PER_KEY_RPM=
RATE_LIMIT_PER_IP_RPM=
MAX_CONCURRENT_LLM=
# Deprecated compatibility fallback; prefer MAX_CONCURRENT_LLM.
MAX_CONCURRENT_OLLAMA=

# Server and upstream timeouts.
UPSTREAM_TIMEOUT=
READINESS_TIMEOUT=
CAPABILITY_DISCOVERY_TTL=
SHUTDOWN_TIMEOUT=
SERVER_READ_TIMEOUT=
SERVER_WRITE_TIMEOUT=
SERVER_IDLE_TIMEOUT=

# Listener and browser access.
LISTEN_ADDR=
CORS_ENABLED=
CORS_ALLOWED_ORIGINS=

# Docker Compose only. Empty values retain the secure Compose defaults.
LOCALM_IMAGE_TAG=
LOCALM_BIND_ADDRESS=
LOCALM_PORT=
