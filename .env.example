# Required client authentication. Use one or more long random values separated
# by commas. Never reuse an upstream/provider key.
API_KEYS=

# Global exposure policy.
ALLOWED_MODELS=

# Optional named-connections file. Leave empty for single-provider mode.
LOCALM_CONFIG=

# Single-provider compatibility mode.
LLM_PROVIDER=
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
OLLAMA_BASE_URL=

# Request, rate, and concurrency limits.
MAX_BODY_BYTES=
MAX_TOKENS=
DEFAULT_MAX_TOKENS=
RATE_LIMIT_PER_KEY_RPM=
RATE_LIMIT_PER_IP_RPM=
MAX_CONCURRENT_LLM=
# Requests that may wait for a busy slot (0 rejects at once) and how long.
MAX_QUEUED_LLM=
QUEUE_TIMEOUT=

# Failover to the next connection and the pause for a failing one.
FAILOVER=
FAILURE_PAUSE=
FAILURE_PAUSE_MAX=
# Deprecated compatibility fallback; prefer MAX_CONCURRENT_LLM.
MAX_CONCURRENT_OLLAMA=

# Server and upstream timeouts.
UPSTREAM_TIMEOUT=
READINESS_TIMEOUT=
CAPABILITY_DISCOVERY_TTL=
SHUTDOWN_TIMEOUT=
SERVER_READ_TIMEOUT=
SERVER_WRITE_TIMEOUT=
SERVER_IDLE_TIMEOUT=

# Optional web research (docs/search.md). Empty SEARCH_BASE_URL keeps it off.
SEARCH_BASE_URL=
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=
SEARCH_MAX_READ_PAGES=
SEARCH_TIMEOUT=
SEARCH_PAGE_TIMEOUT=
SEARCH_PAGE_MAX_BYTES=
SEARCH_PAGE_MAX_CHARS=
SEARCH_SAFESEARCH=
SEARCH_USER_AGENT=
MAX_CONCURRENT_SEARCH=

# Listener and browser access.
LISTEN_ADDR=
CORS_ENABLED=
CORS_ALLOWED_ORIGINS=

# Docker Compose only. Empty values retain the secure Compose defaults.
LOCALM_IMAGE_TAG=
LOCALM_BIND_ADDRESS=
LOCALM_PORT=
