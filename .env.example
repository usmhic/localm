# scripts/serve.sh fills this in for you (docs/laptop.md). By hand, only the first two matter.

# Required: one or more long random keys, comma-separated. Clients send one as a Bearer token.
API_KEYS=
# The models clients may use, comma-separated (as Ollama names them, e.g. qwen3:8b).
ALLOWED_MODELS=

# Where Ollama answers. Empty: http://127.0.0.1:11434 (or the host's, from Docker).
OLLAMA_BASE_URL=

# Room for agents: answer length, request size and how long a slow model may take.
MAX_TOKENS=
DEFAULT_MAX_TOKENS=
MAX_BODY_BYTES=
UPSTREAM_TIMEOUT=
SERVER_WRITE_TIMEOUT=
# How many requests reach the model at once (match OLLAMA_NUM_PARALLEL).
MAX_CONCURRENT_LLM=

# Not Ollama? Name another provider (lmstudio, llamacpp, localai, custom) and its /v1 URL,
# or describe several connections in a YAML file (localm.example.yaml).
LLM_PROVIDER=
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
LOCALM_CONFIG=

# Optional: a named Cloudflare tunnel for a fixed address (empty: a quick, random one).
CLOUDFLARE_TUNNEL_TOKEN=

# Every other setting (other providers, several connections, rate limits, queueing,
# failover, CORS, timeouts) is optional: see docs/configuration.md.
